{
  "name": "Onlyfile",
  "scopeName": "source.onlyfile",
  "patterns": [
    { "include": "#metadataComment" },
    { "include": "#lineComment" },
    { "include": "#namespace" },
    { "include": "#namespaceClose" },
    { "include": "#versionDirective" },
    { "include": "#variableDirective" },
    { "include": "#directive" },
    { "include": "#invalidInlineTask" },
    { "include": "#taskHeader" },
    { "include": "#commandBlock" },
    { "include": "#interpolation" }
  ],
  "repository": {
    "metadataComment": {
      "name": "meta.metadata.onlyfile",
      "begin": "^(\\s*)(\\[(?:help|desc|pass|fail)\\])(?=\\s|$)",
      "beginCaptures": {
        "2": { "name": "entity.other.attribute-name.metadata.onlyfile" }
      },
      "end": "$",
      "patterns": [
        { "include": "#interpolation" }
      ]
    },
    "lineComment": {
      "name": "comment.line.onlyfile",
      "match": "^(\\s*)(#|//)(.*)$",
      "captures": {
        "2": { "name": "punctuation.definition.comment.onlyfile" }
      }
    },
    "namespace": {
      "name": "meta.namespace.onlyfile",
      "match": "^(\\s*)(group)(\\s+)([A-Za-z_-][A-Za-z0-9_-]*)(\\s*)(\\{)?(\\s*)$",
      "captures": {
        "2": { "name": "storage.type.namespace.onlyfile" },
        "4": { "name": "entity.name.type.namespace.onlyfile" },
        "6": { "name": "punctuation.section.braces.begin.onlyfile" }
      }
    },
    "namespaceClose": {
      "name": "meta.namespace.onlyfile",
      "match": "^(\\s*)(\\})(\\s*)$",
      "captures": {
        "2": { "name": "punctuation.section.braces.end.onlyfile" }
      }
    },
    "variableDirective": {
      "name": "meta.directive.variable.onlyfile",
      "match": "^(\\s*)(!var)(\\s+)([A-Za-z_-][A-Za-z0-9_-]*)(\\s*)(=)(\\s*)(\"(?:[^\"\\\\]|\\\\.)*\")(\\s*)$",
      "captures": {
        "2": { "name": "keyword.control.directive.onlyfile" },
        "4": { "name": "variable.other.constant.onlyfile" },
        "6": { "name": "keyword.operator.assignment.onlyfile" },
        "8": { "name": "string.quoted.double.onlyfile" }
      }
    },
    "versionDirective": {
      "name": "meta.directive.version.onlyfile",
      "match": "^(\\s*)(!version)(\\s+)([0-9]+\\.[0-9]+)(\\s*)$",
      "captures": {
        "2": { "name": "keyword.control.directive.onlyfile" },
        "4": { "name": "constant.numeric.version.onlyfile" }
      }
    },
    "directive": {
      "name": "meta.directive.onlyfile",
      "match": "^(\\s*)(![A-Za-z_-][A-Za-z0-9_-]*)(?:\\s+.*)?$",
      "captures": {
        "2": { "name": "keyword.control.guard.onlyfile" }
      }
    },
    "invalidInlineTask": {
      "name": "invalid.illegal.inline-task-command.onlyfile",
      "match": "^(\\s*)[A-Za-z_-][A-Za-z0-9_-]*(?=\\s*\\().*:[ \\t]+\\S.*$"
    },
    "taskHeader": {
      "name": "meta.task.header.onlyfile",
      "begin": "^(\\s*)([A-Za-z_-][A-Za-z0-9_-]*)(?=\\s*\\()",
      "beginCaptures": {
        "2": { "name": "entity.name.function.task.onlyfile" }
      },
      "end": ":\\s*$",
      "endCaptures": {
        "0": { "name": "punctuation.separator.header.onlyfile" }
      },
      "patterns": [
        {
          "name": "variable.parameter.onlyfile",
          "match": "(?<=\\(|,)\\s*([A-Za-z_-][A-Za-z0-9_-]*)(?=\\s*(?:=|,|\\)))"
        },
        {
          "match": "(?<=&)\\s*([A-Za-z_-][A-Za-z0-9_.-]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.dependency.onlyfile"
            }
          }
        },
        {
          "name": "support.function.guard.onlyfile",
          "match": "(?<=@)[A-Za-z_-][A-Za-z0-9_-]*"
        },
        {
          "match": "\\b(shell~=|shell=)([A-Za-z_-][A-Za-z0-9_-]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.shell.onlyfile"
            },
            "2": {
              "name": "string.unquoted.shell.onlyfile"
            }
          }
        },
        { "include": "#string" },
        { "include": "#interpolation" },
        { "include": "#boolean" }
      ]
    },
    "commandBlock": {
      "name": "meta.command.block.onlyfile",
      "begin": "^(\\s*)(\\|)(?=[ \\t]|$)",
      "beginCaptures": {
        "2": { "name": "keyword.control.command-block.onlyfile" }
      },
      "end": "$",
      "contentName": "meta.command.block.content.onlyfile",
      "patterns": [
        { "include": "#commandBlockComment" },
        { "include": "#interpolation" }
      ]
    },
    "commandBlockComment": {
      "match": "(?<=\\|)[ \\t]+(#.*)$",
      "captures": {
        "1": { "name": "comment.line.number-sign.command-block.onlyfile" }
      }
    },
    "interpolation": {
      "name": "meta.interpolation.onlyfile",
      "begin": "\\{\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.onlyfile" }
      },
      "end": "\\}\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.onlyfile" }
      },
      "patterns": [
        {
          "name": "variable.other.interpolation.onlyfile",
          "match": "[A-Za-z_-][A-Za-z0-9_-]*"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.onlyfile",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.onlyfile" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.onlyfile" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.onlyfile",
          "match": "\\\\."
        },
        { "include": "#interpolation" }
      ]
    },
    "boolean": {
      "name": "constant.language.boolean.onlyfile",
      "match": "\\b(?:true|false)\\b"
    }
  }
}
