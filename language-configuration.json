{
  "comments": {
    "lineComment": "//"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*\\[[A-Za-z_-][A-Za-z0-9_-]*\\]\\s*\\{\\s*$",
      "afterText": "^\\s*\\}",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^\\s*\\[[A-Za-z_-][A-Za-z0-9_-]*\\]\\s*\\{\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*[A-Za-z_-][A-Za-z0-9_-]*\\s*\\([^\\r\\n]*\\)[^\\r\\n]*:\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*:\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*\\|(?:[ \\t].*)?$",
      "action": {
        "indent": "none",
        "appendText": "| "
      }
    }
  ],
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"" }
  ]
}
