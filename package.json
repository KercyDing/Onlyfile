{
  "name": "onlyfile",
  "displayName": "Only",
  "version": "0.0.5",
  "description": "VS Code support for Onlyfile with syntax highlighting and only-lsp integration.",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "lsp",
    "only",
    "onlyfile",
    "task"
  ],
  "homepage": "https://github.com/KercyDing/Onlyfile#readme",
  "bugs": {
    "url": "https://github.com/KercyDing/Onlyfile/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KercyDing/Onlyfile.git"
  },
  "publisher": "kercyding",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --watch",
    "check": "tsc -p ./ --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/vscode": "^1.99.0",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "onlyfile.restartLsp",
        "title": "Onlyfile: Restart LSP",
        "category": "Onlyfile"
      },
      {
        "command": "onlyfile.reinstallLsp",
        "title": "Onlyfile: Reinstall LSP",
        "category": "Onlyfile"
      }
    ],
    "languages": [
      {
        "id": "onlyfile",
        "aliases": [
          "Onlyfile",
          "onlyfile"
        ],
        "filenames": [
          "Onlyfile",
          "onlyfile"
        ]
      }
    ],
    "grammars": [
      {
        "language": "onlyfile",
        "scopeName": "source.onlyfile",
        "path": "./syntaxes/onlyfile.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:onlyfile"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.99.0"
  }
}
